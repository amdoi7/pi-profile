{
    "lastChangelogVersion": "0.83.0",
    "defaultProvider": "ciii",
    "defaultModel": "gpt-5.6-luna",
    "defaultThinkingLevel": "max",
    "packages": [
        {
            "source": "git:github.com/HazAT/glimpse",
            "extensions": [],
            "skills": [
                "+skills/glimpse/SKILL.md"
            ],
            "prompts": [],
            "themes": []
        },
        {
            "source": "npm:pi-updater",
            "extensions": [
                "index.ts"
            ],
            "skills": [],
            "prompts": [],
            "themes": []
        }
    ],
    "extensions": [
        "./extensions/memory",
        "./extensions/custom-footer",
        "./extensions/edit",
        "./extensions/apply-patch-ui",
        "./extensions/escape-rewind",
        "./extensions/btw",
        "./extensions/session-breakdown",
        "./extensions/command-policy"
    ],
    "skills": [
        "./extensions/memory/skills",
        "!**/.agents/skills/**"
    ],
    "hideThinkingBlock": false,
    "images": {
        "blockImages": false
    },
    "showHardwareCursor": true,
    "steeringMode": "one-at-a-time",
    "followUpMode": "one-at-a-time",
    "treeFilterMode": "default",
    "theme": "bluloco-dark",
    "collapseChangelog": true,
    "transport": "auto",
    "terminal": {
        "clearOnShrink": true,
        "imageWidthCells": 80,
        "showTerminalProgress": true
    },
    "editorPaddingX": 0,
    "autocompleteMaxVisible": 5,
    "doubleEscapeAction": "tree",
    "warnings": {
        "anthropicExtraUsage": false
    },
    "enableInstallTelemetry": false,
    "quietStartup": false,
    "showCacheMissNotices": true,
    "httpIdleTimeoutMs": 300000,
    "compaction": {
        "enabled": false
    },
    "defaultProjectTrust": "ask"
}
