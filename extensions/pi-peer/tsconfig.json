{
	"compilerOptions": {
		"target": "ES2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"paths": {
			"@earendil-works/pi-coding-agent": [
				"../../node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
			],
			"@earendil-works/pi-tui": ["../../node_modules/@earendil-works/pi-tui/dist/index.d.ts"],
			"typebox": [
				"../../node_modules/@earendil-works/pi-coding-agent/node_modules/typebox/build/index.d.mts"
			]
		}
	},
	"include": ["index.ts", "src/**/*.ts"]
}
