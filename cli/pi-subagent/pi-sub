#!/usr/bin/env bash

set -euo pipefail

readonly PROGRAM_NAME="${0##*/}"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_PATH="$SCRIPT_DIR/${BASH_SOURCE[0]##*/}"
readonly DEFAULT_RUNTIME_ROOT="${TMPDIR:-/tmp}/pi-subagent-$UID"
readonly RUN_ROOT="${PI_SUB_RUN_DIR:-$DEFAULT_RUNTIME_ROOT}"
readonly AGENT_DIR="${PI_CODING_AGENT_DIR:-${HOME:?HOME is required}/.pi/agent}"
readonly SESSION_ROOT="$AGENT_DIR/processes/pi-subagent-sessions"

PI_ARGUMENTS=()
WRITE_SCOPES=()
SELECTED_TOOLS=""
TASK_MODE=""
EFFECTIVE_MODEL=""
EFFECTIVE_PROVIDER=""
EFFECTIVE_THINKING=""

usage() {
	cat <<EOF
Usage:
  $PROGRAM_NAME <alias> (--tools <list> | --no-tools) [pi arguments...]
                                          Start a subagent in the background
  $PROGRAM_NAME --list                    List owner runs as JSON (runId, alias, state, exitCode, model, stateAgeSeconds)
  $PROGRAM_NAME --status <run-id>          Show queued, running, complete, or lost
  $PROGRAM_NAME --cancel <run-id>          Stop a queued or running run (exit 130)
  $PROGRAM_NAME --result <run-id>          Return a completed result
  $PROGRAM_NAME --wait <run-id>            Wait and return the result
  $PROGRAM_NAME --transcript <run-id>      Return the durable Pi session JSONL

The alias maps deterministically to a project-local Pi session. Start returns
a run ID immediately; use --list, --status, --result, --wait, or --transcript to inspect it.
Tools must be selected explicitly. Runs with bash, edit, or write must declare
one or more exclusive paths with --write-scope <path>.
EOF
}

fail() {
	local code="$1"
	local message="$2"
	printf '{"ok":false,"error":{"code":"%s","message":"%s"}}\n' "$code" "$message" >&2
	exit 1
}

shell_quote() {
	local value="$1"
	printf "'%s'" "${value//\'/\'\"\'\"\'}"
}

require_command() {
	command -v "$1" >/dev/null 2>&1 || fail "missing_command" "required command is unavailable: $1"
}

set_model() {
	local model="$1"
	[[ -n "$model" && "$model" != -* && ! "$model" =~ [[:cntrl:]] ]] ||
		fail "invalid_model" "--model requires a non-empty value without control characters"
	[[ -z "$EFFECTIVE_MODEL" ]] || fail "model_conflict" "--model may be supplied only once"
	EFFECTIVE_MODEL="$model"
}

set_provider() {
	local provider="$1"
	[[ -n "$provider" && "$provider" != -* && ! "$provider" =~ [[:cntrl:]] ]] ||
		fail "invalid_provider" "--provider requires a non-empty value without control characters"
	[[ -z "$EFFECTIVE_PROVIDER" ]] || fail "provider_conflict" "--provider may be supplied only once"
	EFFECTIVE_PROVIDER="$provider"
}

set_thinking() {
	local thinking="$1"
	case "$thinking" in
		off | minimal | low | medium | high | xhigh | max) ;;
		*) fail "invalid_thinking" "--thinking requires one of off,minimal,low,medium,high,xhigh,max" ;;
	esac
	[[ -z "$EFFECTIVE_THINKING" ]] || fail "thinking_conflict" "--thinking may be supplied only once"
	EFFECTIVE_THINKING="$thinking"
}

apply_model_context() {
	local inherited_arguments=() inherited_count=0
	if [[ -z "$EFFECTIVE_PROVIDER" && -z "$EFFECTIVE_MODEL" ]]; then
		if [[ -n "${PI_PROVIDER:-}" && -n "${PI_MODEL:-}" ]]; then
			set_provider "$PI_PROVIDER"
			set_model "$PI_MODEL"
			inherited_arguments+=(--provider "$PI_PROVIDER" --model "$PI_MODEL")
			inherited_count=4
		elif [[ -n "${PI_SUB_DEFAULT_MODEL+x}" ]]; then
			set_model "$PI_SUB_DEFAULT_MODEL"
			inherited_arguments+=(--model "$PI_SUB_DEFAULT_MODEL")
			inherited_count=2
		fi
	fi
	if [[ -z "$EFFECTIVE_THINKING" && "$EFFECTIVE_MODEL" =~ :(off|minimal|low|medium|high|xhigh|max)$ ]]; then
		EFFECTIVE_THINKING="${BASH_REMATCH[1]}"
	elif [[ -z "$EFFECTIVE_THINKING" && -n "${PI_REASONING_LEVEL:-}" ]]; then
		set_thinking "$PI_REASONING_LEVEL"
		inherited_arguments+=(--thinking "$PI_REASONING_LEVEL")
		(( inherited_count += 2 ))
	fi
	if (( inherited_count > 0 )); then
		PI_ARGUMENTS=("${inherited_arguments[@]}" "${PI_ARGUMENTS[@]}")
	fi
}

validate_tools() {
	local tools="$1"
	local item seen="," mutation=false
	local tool_items=()
	[[ -n "$tools" && "$tools" != ,* && "$tools" != *, && "$tools" != *,,* ]] ||
		fail "invalid_tools" "--tools requires a non-empty comma-separated built-in tool list"
	IFS=',' read -r -a tool_items <<< "$tools"
	for item in "${tool_items[@]}"; do
		case "$item" in
			read | bash | edit | write | grep | find | ls)
				;;
			*)
				fail "invalid_tools" "unsupported built-in tool in --tools; expected read,bash,edit,write,grep,find,ls"
				;;
		esac
		[[ "$seen" != *",$item,"* ]] || fail "invalid_tools" "--tools must not contain duplicate tool names"
		seen+="$item,"
		case "$item" in
			bash | edit | write) mutation=true ;;
		esac
	done
	SELECTED_TOOLS="$tools"
	if [[ "$mutation" == true ]]; then
		TASK_MODE="mutation"
	else
		TASK_MODE="read-only"
	fi
}

validate_write_scope() {
	local scope="$1"
	[[ -n "$scope" && ! "$scope" =~ [[:cntrl:]] ]] ||
		fail "invalid_write_scope" "--write-scope must be non-empty and contain no control characters"
}

set_capability_selection() {
	local kind="$1"
	local value="${2:-}"
	[[ -z "$TASK_MODE" ]] || fail "capability_conflict" "select exactly one of --tools or --no-tools"
	case "$kind" in
		tools)
			validate_tools "$value"
			PI_ARGUMENTS+=(--tools "$value")
			;;
		none)
			SELECTED_TOOLS="none"
			TASK_MODE="read-only"
			PI_ARGUMENTS+=(--no-tools)
			;;
	esac
}

validate_alias() {
	[[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
		fail "invalid_alias" "alias must match [A-Za-z0-9][A-Za-z0-9._-]*"
}

validate_run_id() {
	[[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
		fail "invalid_run_id" "run ID contains unsupported characters"
}

validate_owner_session_id() {
	local session_id="$1"
	[[ -z "$session_id" || "$session_id" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$ ]] ||
		fail "invalid_owner_session" "PI_SESSION_ID contains unsupported characters"
}

reject_nested_run() {
	[[ "${PI_SUB_DEPTH:-0}" == 0 ]] ||
		fail "nested_subagent" "nested pi-sub runs are disabled; compose subagents in the parent orchestration"
}

parse_start_arguments() {
	local value
	PI_ARGUMENTS=()
	WRITE_SCOPES=()
	SELECTED_TOOLS=""
	TASK_MODE=""
	EFFECTIVE_MODEL=""
	EFFECTIVE_PROVIDER=""
	EFFECTIVE_THINKING=""
	while (( $# > 0 )); do
		case "$1" in
			--write-scope)
				(( $# >= 2 )) || fail "invalid_arguments" "--write-scope requires a path"
				validate_write_scope "$2"
				WRITE_SCOPES+=("$2")
				shift 2
				;;
			--write-scope=*)
				value="${1#--write-scope=}"
				validate_write_scope "$value"
				WRITE_SCOPES+=("$value")
				shift
				;;
			--tools | -t)
				(( $# >= 2 )) || fail "invalid_arguments" "$1 requires a tool list"
				set_capability_selection tools "$2"
				shift 2
				;;
			--tools=*)
				set_capability_selection tools "${1#--tools=}"
				shift
				;;
			--no-tools | -nt)
				set_capability_selection none
				shift
				;;
			--model)
				(( $# >= 2 )) || fail "invalid_arguments" "--model requires a value"
				[[ "$2" != -* ]] || fail "invalid_arguments" "--model requires a value before the next option"
				set_model "$2"
				PI_ARGUMENTS+=(--model "$2")
				shift 2
				;;
			--model=*)
				set_model "${1#--model=}"
				PI_ARGUMENTS+=("$1")
				shift
				;;
			--provider)
				(( $# >= 2 )) || fail "invalid_arguments" "--provider requires a value"
				[[ "$2" != -* ]] || fail "invalid_arguments" "--provider requires a value before the next option"
				set_provider "$2"
				PI_ARGUMENTS+=(--provider "$2")
				shift 2
				;;
			--provider=*)
				set_provider "${1#--provider=}"
				PI_ARGUMENTS+=("$1")
				shift
				;;
			--thinking)
				(( $# >= 2 )) || fail "invalid_arguments" "--thinking requires a value"
				[[ "$2" != -* ]] || fail "invalid_arguments" "--thinking requires a value before the next option"
				set_thinking "$2"
				PI_ARGUMENTS+=(--thinking "$2")
				shift 2
				;;
			--thinking=*)
				set_thinking "${1#--thinking=}"
				PI_ARGUMENTS+=("$1")
				shift
				;;
			-e | -e=* | --extension | --extension=* | --skill | --skill=* | -ne | --no-extensions | -ns | --no-skills)
				fail "capability_ceiling" "extensions and skills are disabled for pi-sub runs"
				;;
			-nbt | --no-builtin-tools | -xt | --exclude-tools | --exclude-tools=*)
				fail "capability_conflict" "use exactly one explicit --tools list or --no-tools"
				;;
			--)
				fail "unsupported_pi_argument" "pi does not support -- as an end-of-options marker"
				;;
			-p | --print | --mode | --mode=* | -c | --continue | -r | --resume | --session | --session=* | --session-id | --session-id=* | --session-dir | --session-dir=* | --fork | --fork=* | --no-session | -n | --name | --name=*)
				fail "reserved_pi_argument" "print, naming, and session selection are owned by pi-sub"
				;;
			--api-key | --system-prompt | --append-system-prompt | --models | --prompt-template | --theme)
				(( $# >= 2 )) || fail "invalid_arguments" "$1 requires a value"
				[[ "$2" != -* && -n "$2" ]] || fail "invalid_arguments" "$1 requires a non-empty value"
				PI_ARGUMENTS+=("$1" "$2")
				shift 2
				;;
			--api-key=* | --system-prompt=* | --append-system-prompt=* | --models=* | --prompt-template=* | --theme=*)
				[[ "${1#*=}" != "" ]] || fail "invalid_arguments" "Pi option values must not be empty"
				PI_ARGUMENTS+=("$1")
				shift
				;;
			-a | --approve | -na | --no-approve | --offline | --verbose | -np | --no-prompt-templates | --no-themes | -nc | --no-context-files)
				PI_ARGUMENTS+=("$1")
				shift
				;;
			-*)
				fail "unsupported_pi_argument" "unsupported Pi option; use only documented pi-sub-compatible flags"
				;;
			*)
				PI_ARGUMENTS+=("$1")
				shift
				;;
		esac
	done
	[[ -n "$TASK_MODE" ]] || fail "capability_required" "select child capabilities explicitly with --tools or --no-tools"
	if [[ "$TASK_MODE" == "mutation" && "${#WRITE_SCOPES[@]}" -eq 0 ]]; then
		fail "write_scope_required" "runs with bash, edit, or write require at least one --write-scope"
	fi
	if [[ "$TASK_MODE" == "read-only" && "${#WRITE_SCOPES[@]}" -gt 0 ]]; then
		fail "unexpected_write_scope" "--write-scope is valid only when bash, edit, or write is enabled"
	fi
}

session_id_for() {
	local alias_name="$1"
	local owner_session_id="$2"
	local digest
	if [[ -n "$owner_session_id" ]]; then
		digest="$(printf '%s\0%s\0%s' "$(pwd -P)" "$owner_session_id" "$alias_name" | shasum -a 256)"
	else
		digest="$(printf '%s\0%s' "$(pwd -P)" "$alias_name" | shasum -a 256)"
	fi
	digest="${digest%% *}"
	# UUIDv8 marks this as an application-defined deterministic identifier.
	printf '%s-%s-8%s-8%s-%s\n' \
		"${digest:0:8}" "${digest:8:4}" "${digest:13:3}" "${digest:17:3}" "${digest:20:12}"
}

session_file_for() {
	local session_id="$1"
	printf '%s/%s.jsonl\n' "$SESSION_ROOT" "$session_id"
}

run_dir_for() {
	local run_id="$1"
	local run_dir
	validate_run_id "$run_id"
	run_dir="$RUN_ROOT/runs/$run_id"
	[[ -d "$run_dir" ]] || fail "run_not_found" "no run exists for the supplied run ID"
	printf '%s\n' "$run_dir"
}

require_run_owner() {
	local run_dir="$1"
	local owner_session_id current_session_id
	[[ -f "$run_dir/owner-session-id" ]] || return
	owner_session_id="$(<"$run_dir/owner-session-id")"
	current_session_id="${PI_SESSION_ID:-}"
	if [[ -n "$owner_session_id" && -n "$current_session_id" && "$owner_session_id" != "$current_session_id" ]]; then
		fail "run_owner_mismatch" "run belongs to another Pi session; collect it from its owner session"
	fi
}

mark_notification_claimed_by_owner() {
	local run_dir="$1"
	local owner_session_id
	[[ -f "$run_dir/owner-session-id" ]] || return 0
	owner_session_id="$(<"$run_dir/owner-session-id")"
	[[ -n "$owner_session_id" && "${PI_SESSION_ID:-}" == "$owner_session_id" ]] || return 0
	if ! (set -o noclobber; : > "$run_dir/notification-claimed") 2>/dev/null; then
		[[ -e "$run_dir/notification-claimed" ]] ||
			fail "notification_claim_failed" "owner collected the run but its notification claim could not be recorded"
	fi
}

publish_status() {
	local run_dir="$1"
	local state="$2"
	local value="${3:-}"
	local temporary
	temporary="$(mktemp "$run_dir/.status.XXXXXX")"
	printf '%s\t%s\n' "$state" "$value" > "$temporary"
	mv "$temporary" "$run_dir/status"
}

read_status() {
	local run_dir="$1"
	local state value
	[[ -f "$run_dir/status" ]] || fail "status_unavailable" "run status has not been published"
	IFS=$'\t' read -r state value < "$run_dir/status" ||
		fail "invalid_status" "run status is unreadable"
	case "$state" in
		queued | running)
			printf '%s\t%s\n' "$state" "$value"
			;;
		complete)
			if [[ ! "$value" =~ ^(0|[1-9][0-9]*)$ ]] || (( 10#$value > 255 )); then
				fail "invalid_status" "completed run status contains an invalid exit code"
			fi
			printf '%s\t%s\n' "$state" "$value"
			;;
		*)
			fail "invalid_status" "run status contains an unknown state"
			;;
	esac
}

run_is_active() {
	local run_dir="$1"
	if lockf -t 0 -k "$run_dir/run.lock" true 2>/dev/null; then
		return 1
	fi
	return 0
}

json_string() {
	local value="$1"
	value="${value//\\/\\\\}"
	value="${value//\"/\\\"}"
	value="${value//$'\t'/\\t}"
	value="${value//$'\r'/\\r}"
	value="${value//$'\n'/\\n}"
	printf '"%s"' "$(LC_ALL=C sed $'s/[[:cntrl:]]//g' <<< "$value")"
}

json_string_or_null() {
	local value="$1"
	if [[ -z "$value" ]]; then
		printf 'null'
	else
		json_string "$value"
	fi
}

status_age_seconds() {
	local run_dir="$1"
	local mtime now age
	mtime="$(stat -f %m "$run_dir/status" 2>/dev/null || stat -f %m "$run_dir" 2>/dev/null || printf '0')"
	now="$(date +%s)"
	age=$(( now - mtime ))
	(( age < 0 )) && age=0
	printf '%d\n' "$age"
}

list_runs() {
	local current_session_id run_dir entry owner_file owner_id state value exit_code_json
	local alias_name model age item
	current_session_id="${PI_SESSION_ID:-}"
	[[ -d "$RUN_ROOT/runs" ]] || { printf '[]\n'; return; }
	local items=()
	while IFS= read -r run_dir; do
		entry="${run_dir##*/}"
		[[ "$entry" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
		# Owner filter matches scanRunsDir: the owner file must exist and equal PI_SESSION_ID.
		owner_file="$run_dir/owner-session-id"
		[[ -f "$owner_file" ]] || continue
		owner_id="$(<"$owner_file")"
		owner_id="${owner_id%$'\n'}"
		[[ "$owner_id" == "$current_session_id" ]] || continue
		state=""
		value=""
		if [[ -f "$run_dir/status" ]]; then
			IFS=$'\t' read -r state value < "$run_dir/status" || { state=""; value=""; }
			case "$state" in
				queued | running)
					if ! run_is_active "$run_dir"; then
						state="lost"
						value=""
					fi
					;;
				complete)
					if [[ ! "$value" =~ ^(0|[1-9][0-9]*)$ ]] || (( 10#$value > 255 )); then
						continue
					fi
					;;
				*)
					continue
					;;
			esac
		else
			# A worker mid-startup holds the lock before publishing queued;
			# only a released lock without status is a lost run.
			if run_is_active "$run_dir"; then
				state="queued"
			else
				state="lost"
			fi
		fi
		if [[ "$state" == "complete" ]]; then
			exit_code_json="$value"
		else
			exit_code_json="null"
		fi
		age="$(status_age_seconds "$run_dir")"
		alias_name=""
		if [[ -f "$run_dir/alias" ]]; then
			IFS= read -r alias_name < "$run_dir/alias"
		fi
		model=""
		if [[ -f "$run_dir/model" ]]; then
			IFS= read -r model < "$run_dir/model"
		fi
		item="$(printf '{"runId":%s,"alias":%s,"state":"%s","exitCode":%s,"model":%s,"stateAgeSeconds":%d}' \
			"$(json_string "$entry")" "$(json_string_or_null "$alias_name")" "$state" "$exit_code_json" \
			"$(json_string_or_null "$model")" "$age")"
		items+=("$item")
	done < <(find "$RUN_ROOT/runs" -mindepth 1 -maxdepth 1 -type d -print | sort)
	if (( ${#items[@]} > 0 )); then
		IFS=,
		printf '[%s]\n' "${items[*]}"
	else
		printf '[]\n'
	fi
}

cancel_run() {
	local run_id="$1"
	local run_dir session_name state value
	run_dir="$(run_dir_for "$run_id")"
	require_run_owner "$run_dir"
	IFS=$'\t' read -r state value <<< "$(read_status "$run_dir")"
	if [[ "$state" == "complete" ]]; then
		printf '{"ok":false,"state":"complete","runId":"%s","error":{"code":"run_not_running","message":"run already completed; use --result or --transcript"}}\n' "$run_id"
		return 1
	fi
	if ! run_is_active "$run_dir"; then
		printf '{"ok":false,"state":"lost","runId":"%s","error":{"code":"worker_lost","message":"worker exited before publishing completion; nothing to cancel"}}\n' "$run_id"
		return 1
	fi
	session_name="pi-sub-${run_id##*.}"
	if ! tmux has-session -t "$session_name" 2>/dev/null; then
		printf '{"ok":false,"state":"%s","runId":"%s","error":{"code":"cancel_failed","message":"worker is active but its tmux session is unavailable"}}\n' "$state" "$run_id"
		return 1
	fi
	if ! tmux kill-session -t "$session_name" 2>/dev/null; then
		printf '{"ok":false,"state":"%s","runId":"%s","error":{"code":"cancel_failed","message":"tmux could not stop the worker session"}}\n' "$state" "$run_id"
		return 1
	fi
	printf '{"ok":true,"state":"cancelled","runId":"%s"}\n' "$run_id"
}

show_status() {
	local run_id="$1"
	local run_dir state value age
	run_dir="$(run_dir_for "$run_id")"
	require_run_owner "$run_dir"
	age="$(status_age_seconds "$run_dir")"
	if [[ ! -f "$run_dir/status" ]]; then
		if run_is_active "$run_dir"; then
			printf '{"ok":true,"state":"queued","runId":"%s","stateAgeSeconds":%d}\n' "$run_id" "$age"
		else
			printf '{"ok":false,"state":"lost","runId":"%s","stateAgeSeconds":%d,"error":{"code":"worker_lost","message":"worker exited before publishing completion"}}\n' "$run_id" "$age"
			return 1
		fi
		return 0
	fi
	IFS=$'\t' read -r state value <<< "$(read_status "$run_dir")"
	if [[ "$state" != "complete" ]] && ! run_is_active "$run_dir"; then
		printf '{"ok":false,"state":"lost","runId":"%s","stateAgeSeconds":%d,"error":{"code":"worker_lost","message":"worker exited before publishing completion"}}\n' "$run_id" "$age"
		return 1
	fi
	if [[ "$state" == "complete" ]]; then
		printf '{"ok":true,"state":"complete","runId":"%s","exitCode":%s,"stateAgeSeconds":%d}\n' "$run_id" "$value" "$age"
	else
		printf '{"ok":true,"state":"%s","runId":"%s","stateAgeSeconds":%d}\n' "$state" "$run_id" "$age"
	fi
}

return_result() {
	local run_id="$1"
	local wait_for_completion="$2"
	local run_dir state exit_code
	run_dir="$(run_dir_for "$run_id")"
	require_run_owner "$run_dir"
	if [[ "$wait_for_completion" == true ]]; then
		lockf -k "$run_dir/run.lock" true
	fi
	if [[ ! -f "$run_dir/status" ]]; then
		if run_is_active "$run_dir"; then
			fail "run_active" "run is not complete; use --status or --wait"
		fi
		fail "worker_lost" "worker exited before publishing completion"
	fi
	IFS=$'\t' read -r state exit_code <<< "$(read_status "$run_dir")"
	if [[ "$state" != "complete" && "$wait_for_completion" == false ]] && run_is_active "$run_dir"; then
		IFS=$'\t' read -r state exit_code <<< "$(read_status "$run_dir")"
		[[ "$state" == "complete" ]] || fail "run_active" "run is not complete; use --status or --wait"
	fi
	if [[ "$state" != "complete" ]]; then
		IFS=$'\t' read -r state exit_code <<< "$(read_status "$run_dir")"
	fi
	if [[ "$state" != "complete" ]]; then
		[[ ! -s "$run_dir/worker.stderr" ]] || cat "$run_dir/worker.stderr" >&2
		fail "worker_lost" "worker exited before publishing completion"
	fi
	[[ -f "$run_dir/stdout" && -f "$run_dir/stderr" ]] ||
		fail "result_unavailable" "completed run has missing output files"
	mark_notification_claimed_by_owner "$run_dir"
	cat "$run_dir/stdout"
	cat "$run_dir/stderr" >&2
	return "$exit_code"
}

return_transcript() {
	local run_id="$1"
	local run_dir session_file
	run_dir="$(run_dir_for "$run_id")"
	require_run_owner "$run_dir"
	[[ -f "$run_dir/session-file" ]] ||
		fail "transcript_unavailable" "run has no durable session metadata"
	session_file="$(<"$run_dir/session-file")"
	[[ -f "$session_file" ]] ||
		fail "transcript_unavailable" "durable session file is unavailable; inspect worker stderr and rerun the task"
	cat "$session_file"
}

execute_run() {
	local run_dir="$1"
	local alias_name="$2"
	local session_id="$3"
	local session_file="$4"
	shift 4
	local exit_code last_reason error_message
	publish_status "$run_dir" running
	unset PI_SUB_INTERNAL PI_SESSION_ID PI_SESSION_FILE PI_PROVIDER PI_MODEL PI_REASONING_LEVEL
	export PI_SUB_DEPTH=1
	set +e
	pi --mode json --session "$session_file" --name "$alias_name" --no-extensions --no-skills "$@" \
		< "$run_dir/stdin" > "$run_dir/events" 2> "$run_dir/stderr"
	exit_code=$?
	set -e
	# Text mode printed the final answer; json mode streams session events only
	# and always exits 0, so stdout, stderr, and the exit code are projected
	# from the last assistant message. Without events, keep the pi exit code.
	last_reason="$(jq -r '[select(.type == "message_end" and .message.role == "assistant")] | last | .message.stopReason // empty' \
		"$run_dir/events" 2>/dev/null || true)"
	if [[ -n "$last_reason" ]]; then
		case "$last_reason" in
			error | aborted) exit_code=1 ;;
			*) exit_code=0 ;;
		esac
	fi
	jq -r '[select(.type == "message_end" and .message.role == "assistant")] | last | .message.content[]? | select(.type == "text") | .text' \
		"$run_dir/events" > "$run_dir/stdout" 2>/dev/null || true
	error_message="$(jq -r '[select(.type == "message_end" and .message.role == "assistant")] | last | .message.errorMessage // empty' \
		"$run_dir/events" 2>/dev/null || true)"
	if [[ -n "$error_message" ]]; then
		printf '%s\n' "$error_message" > "$run_dir/stderr"
	fi
	publish_status "$run_dir" complete "$exit_code"
	return "$exit_code"
}

run_worker() {
	local run_dir="$1"
	local alias_name="$2"
	local session_id="$3"
	local session_file="$4"
	shift 4
	local ready_sent=false
	notify_start_failure() {
		if [[ "$ready_sent" == false && -p "$run_dir/ready" ]]; then
			printf 'failed\n' > "$run_dir/ready" || true
		fi
	}
	# Restore the caller environment first: the tmux server env predates this
	# run and may be stale or missing API keys, LANG, or PI_* variables.
	# Accept only well-formed identifiers; caller environments can carry junk
	# exports that must never kill the worker.
	if [[ -f "$run_dir/env" ]]; then
		while IFS= read -r line; do
			[[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
			export "$line" 2>/dev/null || true
		done < "$run_dir/env"
	fi
	# Install the cancel trap before anything else: a cancel issued during
	# startup must still publish 130 instead of leaving a lost run.
	trap 'publish_status "$run_dir" complete 130; [[ -e "$run_dir/stdout" ]] || : > "$run_dir/stdout"; [[ -e "$run_dir/stderr" ]] || : > "$run_dir/stderr"; exit 130' HUP TERM
	trap notify_start_failure EXIT
	exec 8> "$run_dir/run.lock"
	lockf 8
	publish_status "$run_dir" queued
	printf 'ready\n' > "$run_dir/ready"
	ready_sent=true
	trap - EXIT
	# The durable session file is the stable lock carrier for this alias.
	PI_SUB_INTERNAL=execute lockf -k -n "$session_file" \
		"$SCRIPT_PATH" --execute "$run_dir" "$alias_name" "$session_id" "$session_file" "$@"
}

start_run() {
	local alias_name="$1"
	shift
	local session_id session_file run_dir run_id handshake owner_session_id
	reject_nested_run
	validate_alias "$alias_name"
	parse_start_arguments "$@"
	apply_model_context
	set -- "${PI_ARGUMENTS[@]}"
	owner_session_id="${PI_SESSION_ID:-}"
	validate_owner_session_id "$owner_session_id"
	for command_name in pi shasum lockf mktemp mkfifo tmux jq; do
		require_command "$command_name"
	done
	mkdir -p "$RUN_ROOT/runs" "$SESSION_ROOT"
	session_id="$(session_id_for "$alias_name" "$owner_session_id")"
	session_file="$(session_file_for "$session_id")"
	if ! (set -o noclobber; : > "$session_file") 2>/dev/null; then
		[[ -f "$session_file" ]] ||
			fail "session_unavailable" "durable child session could not be created"
	fi
	run_dir="$(mktemp -d "$RUN_ROOT/runs/$alias_name.XXXXXX")"
	run_id="${run_dir##*/}"
	printf '%s\n' "$alias_name" > "$run_dir/alias"
	printf '%s\n' "$(pwd -P)" > "$run_dir/project-cwd"
	printf '%s\n' "$session_id" > "$run_dir/session-id"
	printf '%s\n' "$session_file" > "$run_dir/session-file"
	printf '%s\n' "$TASK_MODE" > "$run_dir/task-mode"
	printf '%s\n' "$SELECTED_TOOLS" > "$run_dir/tools"
	printf '%s\n' "$EFFECTIVE_PROVIDER" > "$run_dir/provider"
	printf '%s\n' "$EFFECTIVE_MODEL" > "$run_dir/model"
	printf '%s\n' "$EFFECTIVE_THINKING" > "$run_dir/thinking"
	: > "$run_dir/write-scopes"
	if (( ${#WRITE_SCOPES[@]} > 0 )); then
		printf '%s\n' "${WRITE_SCOPES[@]}" > "$run_dir/write-scopes"
	fi
	if [[ -t 0 ]]; then
		: > "$run_dir/stdin"
	else
		cat > "$run_dir/stdin"
	fi
	printf '%s\n' "$owner_session_id" > "$run_dir/owner-session-id"
	env > "$run_dir/env"
	chmod 600 "$run_dir/env"
	mkfifo "$run_dir/ready"
	exec 7<> "$run_dir/ready"
	local session_name worker_command pane_id tmux_env_args
	session_name="pi-sub-${run_id##*.}"
	worker_command="$(shell_quote "$SCRIPT_PATH") --worker $(shell_quote "$run_dir") $(shell_quote "$alias_name") $(shell_quote "$session_id") $(shell_quote "$session_file")"
	for argument in "$@"; do
		worker_command+=" $(shell_quote "$argument")"
	done
	worker_command+=" 2> $(shell_quote "$run_dir/worker.stderr")"
	tmux_env_args=(
		-e "PI_SUB_INTERNAL=worker"
		-e "PI_SUB_RUN_DIR=$RUN_ROOT"
		-e "PI_CODING_AGENT_DIR=$AGENT_DIR"
		-e "HOME=$HOME"
		-e "PATH=$PATH"
	)
	[[ -n "${TMPDIR:-}" ]] && tmux_env_args+=(-e "TMPDIR=$TMPDIR")
	if ! pane_id="$(tmux new-session -d -P -F '#{pane_id}' -s "$session_name" \
		"${tmux_env_args[@]}" \
		"$worker_command" 2> "$run_dir/worker.stderr")"; then
		cat "$run_dir/worker.stderr" >&2
		rm -rf "$run_dir"
		fail "worker_start_failed" "tmux could not start the background worker"
	fi
	tmux set-option -p -t "$pane_id" @name "pi-sub:$run_id" 2>/dev/null || true
	tmux rename-window -t "$session_name:" "$alias_name" 2>/dev/null || true
	if ! IFS= read -r -t "${PI_SUB_READY_TIMEOUT:-30}" handshake <&7; then
		exec 7>&-
		tmux kill-session -t "$session_name" 2>/dev/null || true
		rm -rf "$run_dir"
		fail "worker_start_failed" "background worker did not signal readiness within ${PI_SUB_READY_TIMEOUT:-30}s"
	fi
	exec 7>&-
	rm "$run_dir/ready"
	if [[ "$handshake" != "ready" ]]; then
		cat "$run_dir/worker.stderr" >&2
		tmux kill-session -t "$session_name" 2>/dev/null || true
		rm -rf "$run_dir"
		fail "worker_start_failed" "background worker failed during startup"
	fi
	if [[ -n "$owner_session_id" ]]; then
		printf '{"ok":true,"state":"started","runId":"%s","sessionId":"%s","ownerSessionId":"%s"}\n' \
			"$run_id" "$session_id" "$owner_session_id"
	else
		printf '{"ok":true,"state":"started","runId":"%s","sessionId":"%s","ownerSessionId":null}\n' \
			"$run_id" "$session_id"
	fi
}

case "${1:-}" in
	-h | --help | "")
		usage
		;;
	--status)
		[[ "$#" -eq 2 ]] || fail "invalid_arguments" "--status requires exactly one run ID"
		require_command lockf
		show_status "$2"
		;;
	--list)
		[[ "$#" -eq 1 ]] || fail "invalid_arguments" "--list accepts no arguments"
		require_command lockf
		list_runs
		;;
	--cancel)
		[[ "$#" -eq 2 ]] || fail "invalid_arguments" "--cancel requires exactly one run ID"
		require_command lockf
		require_command tmux
		cancel_run "$2"
		;;
	--result)
		[[ "$#" -eq 2 ]] || fail "invalid_arguments" "--result requires exactly one run ID"
		require_command lockf
		return_result "$2" false
		;;
	--wait)
		[[ "$#" -eq 2 ]] || fail "invalid_arguments" "--wait requires exactly one run ID"
		require_command lockf
		return_result "$2" true
		;;
	--transcript)
		[[ "$#" -eq 2 ]] || fail "invalid_arguments" "--transcript requires exactly one run ID"
		return_transcript "$2"
		;;
	--worker)
		[[ "${PI_SUB_INTERNAL:-}" == "worker" ]] || fail "internal_command" "--worker is an internal pi-sub command"
		reject_nested_run
		shift
		run_worker "$@"
		;;
	--execute)
		[[ "${PI_SUB_INTERNAL:-}" == "execute" ]] || fail "internal_command" "--execute is an internal pi-sub command"
		reject_nested_run
		shift
		execute_run "$@"
		;;
	--*)
		fail "unknown_command" "unknown pi-sub command"
		;;
	*)
		start_run "$@"
		;;
esac
